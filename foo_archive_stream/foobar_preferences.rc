#include <windows.h>
#include "foobar_resource.h"

// foobar's preferences panel can be narrow on high-DPI displays.
// Keep every page below 284 horizontal dialog units and 190 vertical units.
// Large settings are split into child pages, not clipped below the viewport.
IDD_ARCHIVE_GENERAL DIALOGEX 0, 0, 284, 185
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX      "Playback and cache", -1, 8, 5, 268, 125
    LTEXT         "Playback buffer (MB, 1-512):", -1, 16, 22, 188, 12
    EDITTEXT      IDC_BUFFER_MB, 210, 19, 54, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT         "Maximum cache size (MB, 0-20480):", -1, 16, 45, 188, 12
    EDITTEXT      IDC_CACHE_MB, 210, 42, 54, 15, ES_NUMBER | ES_AUTOHSCROLL
    AUTOCHECKBOX  "Clean legacy cache by size", IDC_CACHE_SIZE_CLEANUP, 16, 67, 248, 13
    AUTOCHECKBOX  "Clean legacy cache by age", IDC_CACHE_AGE_CLEANUP, 16, 86, 248, 13
    LTEXT         "Maximum age (days, 1-365):", -1, 16, 109, 188, 12
    EDITTEXT      IDC_CACHE_AGE_DAYS, 210, 106, 54, 15, ES_NUMBER | ES_AUTOHSCROLL

    PUSHBUTTON    "Open cache", IDC_CACHE_VIEW, 12, 138, 79, 18
    PUSHBUTTON    "Clear cache...", IDC_CACHE_CLEAR, 100, 138, 79, 18
    PUSHBUTTON    "Shared settings...", IDC_SHARED_SETTINGS, 188, 138, 87, 18
    LTEXT         "Passwords and diagnostics are on separate pages.", -1, 12, 162, 260, 11
    AUTOCHECKBOX  "Use File Tags (overrides archive title preset)", IDC_USE_FILE_TAGS, 12, 169, 260, 13
END

IDD_ARCHIVE_PASSWORDS DIALOGEX 0, 0, 284, 110
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX      "Archive passwords", -1, 8, 5, 268, 92
    LTEXT         "Password list (blank = FoobarArchiveStream\\keeps.txt):", -1, 16, 23, 249, 14
    EDITTEXT      IDC_PASSWORD_PATH, 16, 44, 188, 16, ES_AUTOHSCROLL
    PUSHBUTTON    "Browse...", IDC_PASSWORD_BROWSE, 209, 43, 58, 18
    LTEXT         "Passwords and prompts are shared with other Archive Stream player integrations.", -1, 16, 71, 248, 20
END

IDD_ARCHIVE_DIAGNOSTICS DIALOGEX 0, 0, 284, 127
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPSIBLINGS | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX      "Diagnostics", -1, 8, 5, 268, 111
    AUTOCHECKBOX  "Enable debug logging", IDC_LOGGING_ENABLED, 16, 24, 248, 14
    LTEXT         "Legacy log path (shared log folder takes precedence):", -1, 16, 48, 248, 13
    EDITTEXT      IDC_LOG_PATH, 16, 68, 188, 16, ES_AUTOHSCROLL
    PUSHBUTTON    "Browse...", IDC_LOG_BROWSE, 209, 67, 58, 18
    PUSHBUTTON    "Open log folder", IDC_LOG_FOLDER, 16, 92, 118, 18
END
